# Copy to .env in this folder OR put it in the folder ABOVE this repo. UmmaCare checks the repo folder first,
# then its parent, and never overwrites variables already set in your shell.

# Required for AI features (course key; permits only gpt-6-luna). Everything else works without it.
PORTKEY_API_KEY=

# Optional: hard daily AI spending cap in USD (default 1.00).
DAILY_BUDGET_USD=1.00
